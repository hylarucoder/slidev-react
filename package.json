{
  "name": "slidev-react",
  "version": "0.4.3",
  "private": true,
  "description": "Open-source React + MDX presentation app/runtime (not published to npm)",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "dev:editorial": "vp run -t example-editorial#dev",
    "dev:deepseek": "vp run -t example-deepseek-explain#dev",
    "dev:site": "vp dev",
    "build:site": "vp run -r build && vp build",
    "typecheck": "vp run -r build && tsc -p tsconfig.json --noEmit",
    "test": "vp test --run",
    "test:browser": "vp test --run --project browser",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "test:smoke:runtime": "node --import tsx ./scripts/smoke-runtime-self-contained.ts",
    "test:smoke:npm-install": "node --import tsx ./scripts/smoke-cli-npm-install.ts",
    "lint": "vp lint --type-aware --tsconfig tsconfig.json packages scripts e2e vite.config.ts vitest.config.ts playwright.config.ts postcss.config.mjs",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "clean": "rm -rf dist .generated .slidev-react output packages/*/dist",
    "preview": "vp preview",
    "changeset": "changeset",
    "release:bump": "tsx ./scripts/bump-version.ts",
    "release:version": "changeset version && pnpm install --lockfile-only",
    "release:publish": "vp run -r build && pnpm run test:smoke:runtime && pnpm run test:smoke:npm-install && changeset publish",
    "prepare": "vp config"
  },
  "dependencies": {
    "@slidev-react/core": "workspace:*",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@antv/g-svg": "^2.1.1",
    "@antv/g2": "^5.4.8",
    "@changesets/cli": "2.31.0",
    "@mdx-js/react": "3.1.1",
    "@playwright/test": "^1.59.1",
    "@slidev-react/cli": "workspace:*",
    "@slidev-react/client": "workspace:*",
    "@slidev-react/node": "workspace:*",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.6.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "lucide-react": "1.14.0",
    "mermaid": "11.14.0",
    "postcss": "^8.5.14",
    "tailwindcss": "4.3.0",
    "tsdown": "^0.22.0",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "^2.2.0",
    "ws": "^8.20.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
